{
  "_note": "CloudBase CLI 声明式部署配置。先用 `node tools/pack.js` 生成 dist/cli/<函数名>/（自包含，含 common/），再执行 cloudbase functions:deploy。",
  "version": "2.0",
  "envId": "{{env.CLOUDBASE_ENV_ID}}",
  "functions": [
    {
      "name": "commitTx",
      "dir": "dist/cli/commitTx",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "installDependency": false
    },
    {
      "name": "getVersions",
      "dir": "dist/cli/getVersions",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 5,
      "installDependency": false
    },
    {
      "name": "getDoc",
      "dir": "dist/cli/getDoc",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "installDependency": false
    },
    {
      "name": "registerAccount",
      "dir": "dist/cli/registerAccount",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "installDependency": false
    },
    {
      "name": "createPairingCode",
      "dir": "dist/cli/createPairingCode",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 5,
      "installDependency": false
    },
    {
      "name": "pair",
      "dir": "dist/cli/pair",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "installDependency": false
    },
    {
      "name": "issueTicket",
      "dir": "dist/cli/issueTicket",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "installDependency": false
    },
    {
      "name": "rotateRecoveryCode",
      "dir": "dist/cli/rotateRecoveryCode",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 5,
      "installDependency": false
    }
  ]
}
