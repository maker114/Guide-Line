[Unit]
Description=GuideLine Sync Server
After=network-online.target

[Service]
Type=simple
User=guideline
Group=guideline
EnvironmentFile=/etc/guideline-sync/env
ExecStart=/usr/bin/python3 /opt/guideline-sync/run.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guideline-sync

[Install]
WantedBy=multi-user.target
