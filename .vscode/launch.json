{
  // 按 F5 时的运行配置。
  //
  // ⚠️ **刻意不写 `deviceId`**：手机 id 是每台设备都可能不同的（原来写死 `51dabb34`）。
  //    放进版本控制会让别人拿到一个用不了的配置，也把自己的设备标识带进了公开仓库（S-7）。
  //    运行时从右下角状态栏选设备即可；真要固定，配在**用户级**的 launch 配置里。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GuideLine（调试）",
      "request": "launch",
      "type": "dart"
    },
    {
      // profile 模式：接近真机性能、但仍带调试信息（看卡顿用）
      "name": "GuideLine（profile）",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    }
  ]
}
