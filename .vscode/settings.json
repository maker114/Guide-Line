{
  // ⚠️ 这里**刻意不写** `"dart.flutterSdkPath"`：它是本机路径（原来写死 `E:\flutter`），
  //    入库之后别人 clone 下来 IDE 会指向一个不存在的目录（S-7）。
  //    需要时配在**用户级设置**里；VS Code 一般也能自己认出来。

  // Dart 文件保存时自动格式化：改完不用手动排版，也避免手写缩进把结构弄乱
  "[dart]": {
    "editor.formatOnSave": true
  },

  // 保存即热重载（调试会话里 `Ctrl+S` 手机上一秒见效）
  "dart.flutterHotReloadOnSave": "always",

  // 源码一律 UTF-8：中文不会变问号/乱码
  "files.encoding": "utf8",

  // 这个仓库的注释与文档都是中文，搜索时不要把它们排除掉
  "search.useIgnoreFiles": true
}
